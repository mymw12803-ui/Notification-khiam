{
  "manifest_version": 3,
  "name": "منظومة الإشعارات - الموظف",
  "short_name": "الإشعارات",
  "version": "1.0.0",
  "description": "استقبال إشعارات وإنذارات الإدارة والرد عليها، ومتابعة حالة العمل.",
  "minimum_chrome_version": "116",
  "permissions": ["tabs", "storage", "alarms", "idle", "notifications", "scripting", "offscreen", "tts"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["ui.js", "content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "منظومة الإشعارات",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
  },
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
}
